# Netlify reads BOTH netlify.toml and this file. Kept here as well so the
# headers survive if the toml is ever replaced by a framework's own config.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Content-Security-Policy
  #
  # This list permits exactly what your page loads today, so switching it on
  # breaks nothing. 'unsafe-inline' is unavoidable while the app is one file of
  # inline <script> and <style>; removing it means moving that code to external
  # files, which is worth doing later but is not a prerequisite for deploying.
  #
  # WHEN YOU ADD ANYTHING, ADD IT HERE TOO, or it will be blocked silently with
  # only a console error to show for it. In particular:
  #   - your Apps Script /exec URL belongs in connect-src (already covered by
  #     script.google.com + script.googleusercontent.com)
  #   - cdn.tailwindcss.com has been REMOVED: the stylesheet is compiled into
  #     index.html, so nothing loads it any more and permitting it would be
  #     leaving a script source open for no reason
  #   - cdn.jsdelivr.net and images.unsplash.com have been REMOVED for the same
  #     reason: every deployed page was checked and nothing loads from either,
  #     so they were two more origins allowed to run script and serve images on
  #     a page that collects passwords, for nothing in return
  #   - 'unsafe-eval' is KEPT, deliberately. Nothing of ours needs it, but
  #     Razorpay Checkout is a third-party bundle that may; the cost of being
  #     wrong is every payment failing at the last step, which is not a thing
  #     to discover in production for a header nobody asked for
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.razorpay.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googleusercontent.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
