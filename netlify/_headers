# Netlify reads BOTH netlify.toml and this file. Kept here as well so the
# headers survive if the toml is ever replaced by a framework's own config.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Content-Security-Policy
  #
  # This list permits exactly what your page loads today, so switching it on
  # breaks nothing. 'unsafe-inline' is unavoidable while the app is one file of
  # inline <script> and <style>; removing it means moving that code to external
  # files, which is worth doing later but is not a prerequisite for deploying.
  #
  # WHEN YOU ADD ANYTHING, ADD IT HERE TOO, or it will be blocked silently with
  # only a console error to show for it. In particular:
  #   - your Apps Script /exec URL belongs in connect-src (already covered by
  #     script.google.com + script.googleusercontent.com)
  #   - if you drop cdn.tailwindcss.com, remove it from script-src
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://images.unsplash.com https://*.razorpay.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googleusercontent.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
