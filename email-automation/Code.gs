/**
 * SaaS Email Marketing Automation — Google Apps Script backend
 * ------------------------------------------------------------
 * The bound Google Sheet is the database:
 *   Settings     key/value pairs: company info, daily cap, secrets
 *   Subscribers  one row per contact; drip_step = next sequence step to consider
 *   Sequences    drip flow: step, delay_days (from signup), subject, template
 *   Campaigns    one-off broadcasts: draft -> scheduled -> sending -> sent
 *   Logs         audit trail of every send, signup, confirm, unsubscribe, error
 *
 * Entry points
 *   doPost(e)           signup API, called from the SaaS website (signup-form.html)
 *   doGet(e)            unsubscribe and double-opt-in confirmation links
 *   runAutomation()     time trigger (hourly): drip sequence + campaigns
 *   onOpen()            adds the "Email Automation" menu to the sheet
 */

const DAY_MS = 24 * 60 * 60 * 1000;

const SHEET_NAMES = {
  settings: 'Settings',
  subscribers: 'Subscribers',
  sequences: 'Sequences',
  campaigns: 'Campaigns',
  logs: 'Logs',
};

const HEADERS = {
  Settings: ['key', 'value'],
  Subscribers: ['email', 'first_name', 'company', 'plan', 'status', 'source', 'signup_at', 'drip_step', 'last_sent_at'],
  Sequences: ['step', 'delay_days', 'subject', 'template', 'active'],
  Campaigns: ['name', 'subject', 'preheader', 'template', 'headline', 'body_html', 'blocks', 'segment_plan', 'status', 'scheduled_at', 'sent_at', 'sent_count'],
  Logs: ['timestamp', 'type', 'email', 'ref', 'status', 'message'],
  Templates: ['name', 'blocks', 'updated_at'],
};

const DEFAULT_SETTINGS = {
  COMPANY_NAME: 'Your SaaS Inc.',
  COMPANY_ADDRESS: '123 Example Street, City, Country', // required by CAN-SPAM / GDPR footers
  FROM_NAME: 'Your SaaS Team',
  REPLY_TO: 'hello@example.com',
  PRODUCT_URL: 'https://example.com',
  WEBAPP_URL: '',              // filled after you deploy the web app (see README)
  SIGNUP_API_KEY: '',          // auto-generated by setupWorkbook()
  UNSUBSCRIBE_SECRET: '',      // auto-generated by setupWorkbook()
  DAILY_SEND_CAP: '400',       // soft cap below Gmail's own daily quota
  DOUBLE_OPT_IN: 'yes',        // 'yes' = new signups must confirm before any email
};
const SECRET_KEYS = ['SIGNUP_API_KEY', 'UNSUBSCRIBE_SECRET'];

const DEFAULT_SEQUENCES = [
  // step, delay_days (days after signup), subject, template, active
  [0, 0, 'Welcome aboard, {{first_name}}!', 'welcome', true],
  [1, 2, 'Get your first win in 5 minutes', 'activation', true],
  [2, 10, 'Your trial ends soon: here is what you unlock', 'trial-ending', true],
];

const SAMPLE_CAMPAIGN = [
  'March product update', 'What is new at {{company}} this month', 'A quick look at what we shipped', 'newsletter', '',
  '<h2 style="font-family:Georgia,serif;font-weight:normal;font-size:24px;margin:0 0 16px;">New this month</h2><p style="margin:0 0 16px;">Hi {{first_name}}, here is what we shipped this month.</p>',
  '[{"type":"heading","text":"New this month"},{"type":"text","text":"Hi {{first_name}}, here is what we shipped this month."}]',
  'all', 'draft', '', '', 0,
];

/* ----------------------------------------------------------------------------
 * Menu and setup
 * -------------------------------------------------------------------------- */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Email Automation')
    .addItem('Open Dispatch', 'showDashboard')
    .addSeparator()
    .addItem('Set up workbook', 'setupWorkbook')
    .addItem('Install hourly trigger', 'installTriggers')
    .addItem('Run automation now', 'runAutomationFromMenu')
    .addItem('Send test welcome to me', 'sendTestEmail')
    .addToUi();
}

function showDashboard() {
  ensureSchema_();
  SpreadsheetApp.getUi().showModalDialog(
    HtmlService.createHtmlOutputFromFile('Admin').setWidth(1200).setHeight(820),
    'Dispatch · Email marketing'
  );
}

/** Creates missing sheets, headers, default settings, sequences and a sample campaign. Safe to re-run. */
function setupWorkbook() {
  const ss = SpreadsheetApp.getActive();

  ensureSchema_();

  // Settings: add missing keys only, generate secrets once, never overwrite user values.
  const settingsSheet = ss.getSheetByName(SHEET_NAMES.settings);
  const existingKeys = readObjects_(SHEET_NAMES.settings).rows.map(r => String(r.key).trim());
  const missing = Object.keys(DEFAULT_SETTINGS).filter(k => !existingKeys.includes(k));
  if (missing.length) {
    const rows = missing.map(k => [
      k,
      DEFAULT_SETTINGS[k] || (SECRET_KEYS.includes(k) ? Utilities.getUuid().replace(/-/g, '') : ''),
    ]);
    settingsSheet.getRange(settingsSheet.getLastRow() + 1, 1, rows.length, 2).setValues(rows);
  }

  const seqSheet = ss.getSheetByName(SHEET_NAMES.sequences);
  if (seqSheet.getLastRow() === 1) {
    seqSheet.getRange(2, 1, DEFAULT_SEQUENCES.length, HEADERS.Sequences.length).setValues(DEFAULT_SEQUENCES);
  }

  const campSheet = ss.getSheetByName(SHEET_NAMES.campaigns);
  if (campSheet.getLastRow() === 1) {
    campSheet.getRange(2, 1, 1, HEADERS.Campaigns.length).setValues([SAMPLE_CAMPAIGN]);
  }

  ss.toast('Workbook is ready. Edit Settings, then deploy the web app and install the trigger.', 'Email Automation', 8);
}

/** Installs one hourly trigger that runs runAutomation(). Removes older copies first. */
function installTriggers() {
  ScriptApp.getProjectTriggers().forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('runAutomation').timeBased().everyHours(1).create();
  SpreadsheetApp.getActive().toast('Hourly trigger installed.', 'Email Automation', 5);
}

/* ----------------------------------------------------------------------------
 * Automation engine (time-driven)
 * -------------------------------------------------------------------------- */

/** Runs the drip sequence and campaigns in one locked pass. */
function runAutomation() {
  const result = withLock_(() => {
    const settings = getSettings_();
    const subs = readObjects_(SHEET_NAMES.subscribers);
    const drip = runDrip_(settings, subs);
    const campaigns = runCampaigns_(settings, subs);
    return `Sent ${drip} drip + ${campaigns} campaign emails.`;
  });
  return result || 'Another run is in progress; skipped.';
}

function runAutomationFromMenu() {
  SpreadsheetApp.getActive().toast(runAutomation(), 'Email Automation', 6);
}

/** Sends each active subscriber the next due step of the Sequences sheet. */
function runDrip_(settings, subs) {
  const steps = readObjects_(SHEET_NAMES.sequences).rows
    .filter(s => isTrue_(s.active))
    .map(s => ({ step: Number(s.step), delayDays: Number(s.delay_days) || 0, subject: s.subject, template: s.template }))
    .filter(s => !isNaN(s.step))
    .sort((a, b) => a.step - b.step);
  if (!steps.length) return 0;

  let budget = getSendBudget_(settings);
  let sent = 0;
  const now = Date.now();

  for (const sub of subs.rows) {
    if (budget <= 0) break;
    if (String(sub.status).toLowerCase() !== 'active') continue;

    // Skip over disabled steps: the first active step at or after drip_step.
    const next = steps.find(s => s.step >= Number(sub.drip_step || 0));
    if (!next) continue;

    const signupMs = toMillis_(sub.signup_at);
    if (signupMs === null || now < signupMs + next.delayDays * DAY_MS) continue;

    const res = sendEmail_(sub, next.subject, next.template, settings, { type: 'drip', ref: 'step-' + next.step });
    if (res.ok) {
      sent++;
      budget--;
      updateFields_(subs.sheet, subs.headers, sub.__row, { drip_step: next.step + 1, last_sent_at: new Date() });
    } else if (res.bounced) {
      updateFields_(subs.sheet, subs.headers, sub.__row, { status: 'bounced' });
    }
  }
  return sent;
}

/** Works through scheduled/sending campaigns, skipping anyone already sent this campaign. */
function runCampaigns_(settings, subs) {
  const camps = readObjects_(SHEET_NAMES.campaigns);
  const now = Date.now();
  let budget = getSendBudget_(settings);
  let total = 0;

  for (const c of camps.rows) {
    if (budget <= 0) break;
    const status = String(c.status).toLowerCase();
    const name = String(c.name || '').trim();
    if (!name) continue;
    if (status !== 'scheduled' && status !== 'sending') continue;
    if (status === 'scheduled' && c.scheduled_at && toMillis_(c.scheduled_at) > now) continue;

    const alreadySent = loggedRecipients_('campaign', name);
    const segment = String(c.segment_plan || 'all').trim().toLowerCase();
    const recipients = subs.rows.filter(s =>
      String(s.status).toLowerCase() === 'active' &&
      (segment === 'all' || String(s.plan).toLowerCase() === segment) &&
      !alreadySent.has(normalizeEmail_(s.email))
    );

    updateFields_(camps.sheet, camps.headers, c.__row, { status: 'sending' });

    let passSent = 0;
    let exhausted = false;
    for (const sub of recipients) {
      if (budget <= 0) { exhausted = true; break; }
      const res = sendEmail_(sub, c.subject, c.template, settings, {
        type: 'campaign',
        ref: name,
        extra: campaignExtra_(c, sub, settings, true),
      });
      if (res.ok) {
        passSent++;
        budget--;
      } else if (res.bounced) {
        updateFields_(subs.sheet, subs.headers, sub.__row, { status: 'bounced' });
      }
    }

    total += passSent;
    const update = { sent_count: (Number(c.sent_count) || 0) + passSent };
    if (!exhausted) {
      update.status = 'sent';
      update.sent_at = new Date();
    }
    updateFields_(camps.sheet, camps.headers, c.__row, update);
  }
  return total;
}

/* ----------------------------------------------------------------------------
 * Sending
 * -------------------------------------------------------------------------- */

/**
 * Renders and sends one email. Never throws: returns { ok, bounced }.
 * meta: { type, ref, extra }
 */
function sendEmail_(sub, subjectTpl, templateName, settings, meta) {
  const email = normalizeEmail_(sub.email);
  try {
    const html = renderEmail_(templateName, sub, settings, meta.extra);
    const options = {
      to: email,
      subject: merge_(subjectTpl, sub, false),
      htmlBody: html,
      name: settings.FROM_NAME,
    };
    if (settings.REPLY_TO) options.replyTo = settings.REPLY_TO;
    MailApp.sendEmail(options);
    logEvent_(meta.type, email, meta.ref, 'sent', '');
    return { ok: true, bounced: false };
  } catch (err) {
    const msg = String((err && err.message) || err);
    const bounced = /invalid email|invalid address/i.test(msg);
    logEvent_(meta.type, email, meta.ref, bounced ? 'bounced' : 'error', msg);
    return { ok: false, bounced };
  }
}

/** Fills templates/<name>.html inside templates/base.html. */
function renderEmail_(templateName, sub, settings, extra) {
  const data = Object.assign({
    firstName: sub.first_name || 'there',
    company: sub.company || '',
    plan: sub.plan || '',
    productUrl: settings.PRODUCT_URL || '',
    companyName: settings.COMPANY_NAME || '',
    companyAddress: settings.COMPANY_ADDRESS || '',
    unsubscribeUrl: buildActionUrl_('unsubscribe', sub.email, settings),
    confirmUrl: '',
    headline: '',
    bodyHtml: '',
    preheader: '',
    pixel: '',
  }, extra || {});

  // Campaign sends get click links rewritten and an open-tracking pixel added (see Api.gs).
  if (data.track && data.campaignName) {
    data.bodyHtml = trackLinks_(data.bodyHtml, data.campaignName, sub.email, settings);
    data.pixel = openPixel_(data.campaignName, sub.email, settings);
  }

  const body = fillTemplate_('templates/' + templateName, data);
  return fillTemplate_('templates/base', Object.assign({}, data, { body }));
}

function fillTemplate_(name, data) {
  const t = HtmlService.createTemplateFromFile(name);
  Object.keys(data).forEach(k => { t[k] = data[k]; });
  return t.evaluate().getContent();
}

/** Replaces {{first_name}}, {{company}}, {{plan}}. Escape only for HTML fragments. */
function merge_(text, sub, escape) {
  const map = {
    first_name: sub.first_name || 'there',
    company: sub.company || '',
    plan: sub.plan || '',
  };
  return String(text == null ? '' : text).replace(/\{\{\s*(\w+)\s*\}\}/g, (_, key) => {
    const v = map[key] !== undefined ? String(map[key]) : '';
    return escape ? escapeHtml_(v) : v;
  });
}

/** Daily budget = min(Gmail quota left today, DAILY_SEND_CAP minus sends already logged today). */
function getSendBudget_(settings) {
  const tz = Session.getScriptTimeZone();
  const today = Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd');
  const sentToday = readObjects_(SHEET_NAMES.logs).rows.filter(l =>
    l.status === 'sent' && l.timestamp instanceof Date &&
    Utilities.formatDate(l.timestamp, tz, 'yyyy-MM-dd') === today
  ).length;
  const cap = Number(settings.DAILY_SEND_CAP) || 0;
  return Math.max(0, Math.min(MailApp.getRemainingDailyQuota(), cap - sentToday));
}

/* ----------------------------------------------------------------------------
 * Web app: signup API (POST) and confirm / unsubscribe links (GET)
 * -------------------------------------------------------------------------- */

function doPost(e) {
  let input;
  try {
    input = JSON.parse((e && e.postData && e.postData.contents) || '{}');
  } catch (err) {
    input = (e && e.parameter) || {};   // form-encoded fallback
  }

  let result;
  try {
    result = withLock_(() => addSubscriber_(input)) || { ok: false, error: 'busy' };
  } catch (err) {
    logEvent_('error', '', 'doPost', 'error', String(err));
    result = { ok: false, error: 'server_error' };
  }
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

function doGet(e) {
  const p = (e && e.parameter) || {};
  const action = String(p.action || '').toLowerCase();
  if (action === 'click' || action === 'open') return handleTracking_(action, p);
  const email = normalizeEmail_(p.email);

  const page = withLock_(() => {
    if (action === 'unsubscribe') return handleUnsubscribe_(email, p.token);
    if (action === 'confirm') return handleConfirm_(email, p.token);
    return htmlPage_('Email preferences', 'This link is not valid.');
  });
  return page || htmlPage_('Please try again', 'The server is busy. Refresh this page in a moment.');
}

function addSubscriber_(input) {
  const settings = getSettings_();
  if (settings.SIGNUP_API_KEY && input.api_key !== settings.SIGNUP_API_KEY) {
    return { ok: false, error: 'unauthorized' };
  }
  if (input.website) return { ok: true, status: 'subscribed' };   // honeypot field filled: bot

  const email = normalizeEmail_(input.email);
  if (!isValidEmail_(email)) return { ok: false, error: 'invalid_email' };

  const subs = readObjects_(SHEET_NAMES.subscribers);
  const exists = subs.rows.some(r => normalizeEmail_(r.email) === email);
  // Same response either way, so the endpoint does not reveal who is already a subscriber.
  if (exists) return { ok: true, status: 'subscribed' };

  const pending = String(settings.DOUBLE_OPT_IN).toLowerCase() === 'yes';
  const sub = {
    email,
    first_name: clean_(input.first_name),
    company: clean_(input.company),
    plan: clean_(input.plan) || 'free',
    status: pending ? 'pending' : 'active',
    source: clean_(input.source) || 'website',
    signup_at: new Date(),
    drip_step: 0,
    last_sent_at: '',
  };
  subs.sheet.appendRow(subs.headers.map(h => (sub[h] !== undefined ? sub[h] : '')));
  logEvent_('signup', email, sub.source, 'ok', sub.status);

  if (pending) {
    sendEmail_(sub, 'Please confirm your subscription', 'double-opt-in', settings, {
      type: 'confirm',
      ref: 'double-opt-in',
      extra: { confirmUrl: buildActionUrl_('confirm', email, settings) },
    });
  }
  return { ok: true, status: 'subscribed' };
}

function handleConfirm_(email, token) {
  const settings = getSettings_();
  if (!verifyToken_('confirm', email, token, settings)) {
    return htmlPage_('Link not valid', 'This confirmation link is invalid or has expired.');
  }
  const subs = readObjects_(SHEET_NAMES.subscribers);
  const row = subs.rows.find(r => normalizeEmail_(r.email) === email);
  if (!row) return htmlPage_('Link not valid', 'We could not find that subscription.');
  if (String(row.status).toLowerCase() === 'unsubscribed') {
    return htmlPage_('Already unsubscribed', 'This address has unsubscribed. You can sign up again from our website.');
  }
  if (String(row.status).toLowerCase() === 'pending') {
    // Restart the drip clock from confirmation so day-2 and day-10 emails are not back-dated.
    updateFields_(subs.sheet, subs.headers, row.__row, { status: 'active', signup_at: new Date(), drip_step: 0 });
    logEvent_('confirm', email, '', 'ok', '');
  }
  return htmlPage_('You are subscribed', 'Thanks! Your first email is on its way.');
}

function handleUnsubscribe_(email, token) {
  const settings = getSettings_();
  if (!verifyToken_('unsubscribe', email, token, settings)) {
    return htmlPage_('Link not valid', 'This unsubscribe link is invalid.');
  }
  const subs = readObjects_(SHEET_NAMES.subscribers);
  const row = subs.rows.find(r => normalizeEmail_(r.email) === email);
  if (row && String(row.status).toLowerCase() !== 'unsubscribed') {
    updateFields_(subs.sheet, subs.headers, row.__row, { status: 'unsubscribed' });
    logEvent_('unsubscribe', email, '', 'ok', '');
  }
  return htmlPage_('You are unsubscribed', 'You will no longer receive these emails.');
}

/* ----------------------------------------------------------------------------
 * Tokens (HMAC-signed links, so nobody can unsubscribe someone else)
 * -------------------------------------------------------------------------- */

function buildActionUrl_(action, email, settings) {
  const base = settings.WEBAPP_URL || ScriptApp.getService().getUrl();
  return base + '?action=' + action +
    '&email=' + encodeURIComponent(normalizeEmail_(email)) +
    '&token=' + signToken_(action, email, settings);
}

function signToken_(action, email, settings) {
  if (!settings.UNSUBSCRIBE_SECRET) {
    throw new Error('UNSUBSCRIBE_SECRET is empty. Run Email Automation > Set up workbook.');
  }
  const sig = Utilities.computeHmacSha256Signature(
    action + ':' + normalizeEmail_(email),
    settings.UNSUBSCRIBE_SECRET
  );
  return Utilities.base64EncodeWebSafe(sig).replace(/=+$/, '');
}

function verifyToken_(action, email, token, settings) {
  if (!email || !token) return false;
  return signToken_(action, email, settings) === String(token);
}

/* ----------------------------------------------------------------------------
 * Dashboard API (called from Dashboard.html via google.script.run)
 * -------------------------------------------------------------------------- */

function getDashboardStats() {
  const settings = getSettings_();
  const subs = readObjects_(SHEET_NAMES.subscribers).rows;
  const count = s => subs.filter(r => String(r.status).toLowerCase() === s).length;
  const campaigns = readObjects_(SHEET_NAMES.campaigns).rows
    .filter(c => String(c.name || '').trim())
    .map(c => ({ name: String(c.name), status: String(c.status), sent_count: Number(c.sent_count) || 0 }));

  return {
    active: count('active'),
    pending: count('pending'),
    unsubscribed: count('unsubscribed'),
    bounced: count('bounced'),
    budgetLeft: getSendBudget_(settings),
    dailyCap: Number(settings.DAILY_SEND_CAP) || 0,
    campaigns,
  };
}

function sendTestEmail() {
  const settings = getSettings_();
  const me = Session.getEffectiveUser().getEmail();
  const sub = { email: me, first_name: 'Test', company: 'Test Co', plan: 'pro', status: 'active' };
  const res = sendEmail_(sub, 'TEST: Welcome aboard, {{first_name}}!', 'welcome', settings, { type: 'test', ref: 'test' });
  const msg = res.ok ? 'Test email sent to ' + me : 'Test failed. See the Logs sheet.';
  SpreadsheetApp.getActive().toast(msg, 'Email Automation', 5);
  return msg;
}

/* ----------------------------------------------------------------------------
 * Sheet helpers
 * -------------------------------------------------------------------------- */

function getSheet_(name) {
  const sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error(`Missing sheet "${name}". Run Email Automation > Set up workbook.`);
  return sh;
}

/** Reads a sheet as objects. Each row gets __row (its 1-based sheet row) for updates. */
function readObjects_(name) {
  const sheet = getSheet_(name);
  const data = sheet.getDataRange().getValues();
  const headers = (data[0] || []).map(h => String(h).trim());
  const rows = data.slice(1).map((r, i) => {
    const o = { __row: i + 2 };
    headers.forEach((h, j) => { o[h] = r[j]; });
    return o;
  });
  return { sheet, headers, rows };
}

function updateFields_(sheet, headers, row, fields) {
  Object.keys(fields).forEach(k => {
    const col = headers.indexOf(k) + 1;
    if (col > 0) sheet.getRange(row, col).setValue(fields[k]);
  });
}

function getSettings_() {
  const s = Object.assign({}, DEFAULT_SETTINGS);
  readObjects_(SHEET_NAMES.settings).rows.forEach(r => {
    const k = String(r.key || '').trim();
    if (k) s[k] = String(r.value == null ? '' : r.value).trim();
  });
  return s;
}

function logEvent_(type, email, ref, status, message) {
  getSheet_(SHEET_NAMES.logs).appendRow([new Date(), type, email || '', ref || '', status, message || '']);
}

/** Emails already sent for a given campaign, so re-runs never double-send. */
function loggedRecipients_(type, ref) {
  const set = new Set();
  readObjects_(SHEET_NAMES.logs).rows.forEach(l => {
    if (l.type === type && l.ref === ref && l.status === 'sent') set.add(normalizeEmail_(l.email));
  });
  return set;
}

/* ----------------------------------------------------------------------------
 * Small utilities
 * -------------------------------------------------------------------------- */

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return null;
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

function normalizeEmail_(v) {
  return String(v == null ? '' : v).trim().toLowerCase();
}

function isValidEmail_(v) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) && v.length <= 254;
}

/** Trims, caps length and neutralises spreadsheet formula injection (=, +, -, @). */
function clean_(v) {
  return String(v == null ? '' : v).trim().slice(0, 200).replace(/^[=+\-@]/, "'$&");
}

function isTrue_(v) {
  return v === true || ['true', 'yes', 'y', '1'].includes(String(v).trim().toLowerCase());
}

function toMillis_(v) {
  if (v === '' || v === null || v === undefined) return null;
  const t = v instanceof Date ? v.getTime() : new Date(v).getTime();
  return isNaN(t) ? null : t;
}

function escapeHtml_(s) {
  return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function htmlPage_(title, message) {
  const html = `<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>${escapeHtml_(title)}</title></head>
<body style="font-family:Arial,Helvetica,sans-serif;max-width:480px;margin:64px auto;padding:0 16px;color:#1f2937">
<h2>${escapeHtml_(title)}</h2><p>${escapeHtml_(message)}</p></body></html>`;
  return HtmlService.createHtmlOutput(html).setTitle(title);
}
