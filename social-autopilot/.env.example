# Copy to .env for local use (netlify dev / npm run setup-sheet).
# On Netlify, set the same keys with: netlify env:set NAME "value"

# --- Login ---------------------------------------------------------------
DASHBOARD_PASSWORD=
# 48+ random characters. Generate with: npm run secrets
SESSION_SECRET=
# 32 random bytes, base64. Generate with: npm run secrets
TOKEN_ENCRYPTION_KEY=
# Your public site URL, no trailing slash. Used for OAuth redirects and media URLs.
SITE_URL=https://your-site.netlify.app

# --- Google Sheets (database) ---------------------------------------------
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the JSON key file. Keep the \n sequences as they are.
GOOGLE_PRIVATE_KEY=

# --- Meta (Facebook Page + Instagram) -------------------------------------
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Company Pages need the Community Management API. Leave false until it is approved.
LINKEDIN_ORG_ENABLED=false

# --- AI (used from Phase 3) -------------------------------------------------
TEXT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
