# =============================================================================
# Domebox — every setting and secret the system needs, with placeholder values.
# Copy to .env only for local tools; never commit a real value. .env is ignored.
#
# WHERE THESE ACTUALLY LIVE
#   Domebox runs on Google Apps Script, which has no .env file. Its equivalent
#   is Script Properties: Apps Script editor > Project Settings > Script
#   Properties. Everything in section 1 goes there, one property per line.
#   Nothing in section 1 is ever sent to the browser.
# =============================================================================

# --- 1. Apps Script — Script Properties (server side only) -------------------

# Created by freshStart(); back these up somewhere safe.
MASTER_DB_ID=your-master-spreadsheet-id
TEMPLATE_ID=your-template-spreadsheet-id
AUTH_PEPPER=long-random-string-made-by-freshStart          # SECRET: password hashing key
TOKEN_SECRET=long-random-string-made-by-freshStart         # SECRET: signs sign-in tokens
REMINDERS_LIVE=yes

# Online payment (full edition only).
RAZORPAY_KEY_ID=rzp_live_your_key_id                        # public: sent to the checkout
RAZORPAY_KEY_SECRET=your-razorpay-key-secret                # SECRET: server only

# Sender and links.
MAIL_FROM=info@biscsindia.com                               # Lite: mis@dynamicengineers.in
SITE_URL=https://www.domebox.in                             # Lite: the Lite website address

# Invoices (full edition).
SELLER_ADDRESS=registered address
SELLER_STATE=West Bengal
SELLER_STATE_CODE=19
SELLER_PHONE=+91 90000 00000
SELLER_PAN=ABCDE1234F
SELLER_GSTIN=                                               # only if GST-registered
SELLER_LEGAL_NAME=BISCS India
INVOICE_PREFIX=BISCS
PROMO_CODES={"LAUNCH20":20}

# Demo accounts — made at random by createDemoAccount() if left unset.
DEMO_PASSWORD=random-made-by-createDemoAccount              # SECRET
DEMO_STAFF_PASSWORD=random-made-by-createDemoAccount        # SECRET

# Optional features.
GEMINI_KEY=your-gemini-api-key                              # SECRET: AI insights
WA_TOKEN=your-whatsapp-cloud-api-token                      # SECRET: only when WhatsApp goes live
WA_PHONE_ID=your-whatsapp-phone-number-id
WA_VERIFY_TOKEN=random-string-you-choose                    # SECRET

# --- 2. Website build (netlify/build.js, Git-connected deploys only) ----------
# The drag-and-drop site reads its settings from domebox-config.js instead,
# which holds only public values: the /exec address and the company details
# printed on the legal pages.
API_URL=https://script.google.com/macros/s/your-deployment-id/exec   # public
ALLOW_MISSING_LEGAL=0

# --- 3. Old Next.js prototype (src/app, src/ai) — not part of Domebox ---------
GEMINI_API_KEY=your-gemini-api-key                          # SECRET: server only, no NEXT_PUBLIC_ prefix
